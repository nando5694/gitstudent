                updateFlowExplanation(
                    'git push origin main',
                    '¡Commits enviados desde tu PC hacia la Nube (GitHub/GitLab)!',
                    'Con <code class="text-purple-400">git push</code> copiaste todos los commits nuevos de <strong>3. Repositorio Local</strong> hacia <strong>4. Repositorio Remoto</strong>. Ahora todo tu equipo de trabajo puede ver y descargar tus avances.',
                    'Paso 4/4: ¡Repositorio local y remoto 100% sincronizados!'
                );
                showToast('git push → Código publicado en GitHub con éxito', 'purple');
            }
            else if (action === 'fetch') {
                const mateHash = '9f8e7d6';
                const alreadyExists = flowState.remote.some(c => c.hash === mateHash);
                if (!alreadyExists) {
                    flowState.remote.push({
                        id: 'c_mate',
