            block.innerHTML = `
                <div class="flex items-center gap-2">
                    <span class="text-emerald-400">dev@empresa</span>
                    <span class="text-purple-400">(${simState.HEAD})</span>
                    <span class="text-white font-semibold">$ ${cmd}</span>
                </div>
                <div class="${isError ? 'text-red-400' : 'text-gray-300'} pl-2 whitespace-pre-wrap">${outputHtml}</div>
            `;
            termOut.appendChild(block);
            termOut.scrollTop = termOut.scrollHeight;
        }

        function clearTerminalOutput() {
            document.getElementById('terminal-output').innerHTML = '';
        }

        function handleTerminalSubmit(e) {
            e.preventDefault();
            const input = document.getElementById('terminal-input');
            const rawCmd = input.value.trim();
            if (!rawCmd) return;
            input.value = '';
            runSimCommand(rawCmd);
        }

        function runSimCommand(rawCmd) {
            const cmd = rawCmd.trim();
            const parts = cmd.match(/(?:[^\s"]+|"[^"]*")+/g) || [];
            const mainBin = parts[0];

            if (mainBin === 'clear') {
                clearTerminalOutput();
                return;
            }

            if (mainBin === 'touch' || mainBin === 'edit') {
                const fileName = parts[1] || ('modulo_' + (simState.workingFiles.length + 1) + '.js');
                if (!simState.workingFiles.includes(fileName)) {
                    simState.workingFiles.push(fileName);
                }
                appendTerminalLine(cmd, `<span class="text-amber-300">Archivo '${fileName}' modificado en tu Working Directory. (Usa 'git status' o 'git add .')</span>`);
                updateSimUI();
                return;
            }

            if (mainBin !== 'git') {
                appendTerminalLine(cmd, `Comando '${mainBin}' no reconocido. Prueba comandos con 'git ...' o 'touch archivo.js'.`, true);
                return;
            }

            const sub = parts[1];

            // --- git init ---
            if (sub === 'init') {
                appendTerminalLine(cmd, `Reinitialized existing Git repository in /home/dev/proyecto-trabajo/.git/`);
            }
            // --- git config ---
            else if (sub === 'config') {
                appendTerminalLine(cmd, `user.name=Desarrollador Pro\nuser.email=dev@empresa.com\ncore.editor=code --wait\ninit.defaultBranch=main`);
            }
            // --- git help ---
            else if (sub === 'help' || !sub) {
                appendTerminalLine(cmd, `Comandos disponibles en el simulador:\n  git status, git add ., git commit -m "msg"\n  git branch, git switch -c <rama>, git checkout <rama>\n  git merge <rama>, git reset --soft HEAD~1, git reset --hard HEAD~1\n  git revert HEAD, git stash, git stash pop, git log, git reflog, git push, git pull`);
            }
            // --- git status ---
            else if (sub === 'status') {
                let out = `On branch <strong class="text-purple-400">${simState.HEAD}</strong>\n`;
                if (simState.stagedFiles.length === 0 && simState.workingFiles.length === 0) {
                    out += `<span class="text-emerald-400">nothing to commit, working tree clean</span>`;
                } else {
                    if (simState.stagedFiles.length > 0) {
                        out += `<span class="text-emerald-400">Changes to be committed:</span>\n  (use "git restore --staged <file>..." to unstage)\n`;
                        simState.stagedFiles.forEach(f => { out += `\t<span class="text-emerald-300">modified/new:   ${f}</span>\n`; });
                    }
                    if (simState.workingFiles.length > 0) {
                        out += `<span class="text-amber-400">Changes not staged for commit / Untracked:</span>\n  (use "git add <file>..." to update what will be committed)\n`;
                        simState.workingFiles.forEach(f => { out += `\t<span class="text-amber-300">modified:   ${f}</span>\n`; });
                    }
                }
                appendTerminalLine(cmd, out);
            }
            // --- git add ---
            else if (sub === 'add') {
                if (simState.workingFiles.length === 0) {
                    // Si el usuario hace git add sin haber creado archivos, creamos uno automático para que su experiencia sea fluida
                    simState.stagedFiles.push('app.js');
                    appendTerminalLine(cmd, `<span class="text-emerald-400">Se detectó cambio en 'app.js' y se movió al Área de Staging. Listo para 'git commit'.</span>`);
                } else {
                    simState.stagedFiles.push(...simState.workingFiles);
                    simState.workingFiles = [];
                    appendTerminalLine(cmd, `<span class="text-emerald-400">Archivos agregados a Staging Area (${simState.stagedFiles.join(', ')}).</span>`);
                }
            }
            // --- git restore ---
            else if (sub === 'restore') {
                if (parts.includes('--staged')) {
                    simState.workingFiles.push(...simState.stagedFiles);
                    simState.stagedFiles = [];
                    appendTerminalLine(cmd, `<span class="text-amber-300">Archivos devueltos de Staging a tu Working Directory (tu código sigue intacto).</span>`);
                } else {
                    simState.workingFiles = [];
                    appendTerminalLine(cmd, `<span class="text-orange-400">Cambios no guardados descartados del Working Directory.</span>`);
                }
            }
            // --- git commit ---
            else if (sub === 'commit') {
                let msg = 'feat: actualización de código';
                const mIndex = parts.indexOf('-m');
                if (mIndex !== -1 && parts[mIndex + 1]) {
                    msg = parts[mIndex + 1].replace(/^"|"$/g, '').replace(/^'|'$/g, '');
                }
                if (parts.includes('--amend')) {
                    const currentHash = simState.branches[simState.HEAD];
                    const currentCommit = simState.commits.find(c => c.hash === currentHash);
                    if (currentCommit) {
                        currentCommit.msg = msg + ' (amended)';
                        appendTerminalLine(cmd, `[${simState.HEAD} ${currentCommit.hash}] ${currentCommit.msg}\n <span class="text-blue-400">Último commit actualizado con --amend sin crear nodo adicional.</span>`);
                    }
                } else {
                    const newHash = generateShortHash();
                    const parentHash = simState.branches[simState.HEAD];
                    const lastX = simState.commits.length > 0 ? Math.max(...simState.commits.map(c => c.x)) : 40;
                    const isMain = simState.HEAD === 'main';
                    const newCommit = {
                        hash: newHash,
                        msg: msg,
                        parent: parentHash,
                        secondParent: null,
                        branchTrack: simState.HEAD,
                        x: lastX + 115,
                        y: isMain ? 100 : 200
                    };
                    simState.commits.push(newCommit);
                    simState.branches[simState.HEAD] = newHash;
                    simState.stagedFiles = [];
                    simState.reflog.unshift({ hash: newHash, action: `commit: ${msg}` });
                    appendTerminalLine(cmd, `[${simState.HEAD} <strong class="text-blue-400">${newHash}</strong>] ${msg}\n 1 file changed, 18 insertions(+)`);
                }
            }
            // --- git branch ---
            else if (sub === 'branch') {
                if (!parts[2]) {
                    const list = Object.keys(simState.branches).map(b => 
                        b === simState.HEAD ? `* <strong class="text-emerald-400">${b}</strong>` : `  ${b}`
                    ).join('\n');
                    appendTerminalLine(cmd, list);
                } else if (parts[2] === '-d' || parts[2] === '-D') {
                    const target = parts[3];
                    if (!target || target === 'main') {
                        appendTerminalLine(cmd, `error: No puedes borrar la rama principal 'main'.`, true);
                    } else if (target === simState.HEAD) {
                        appendTerminalLine(cmd, `error: No puedes borrar la rama '${target}' mientras estás parado en ella. Haz 'git switch main' primero.`, true);
                    } else if (simState.branches[target]) {
                        delete simState.branches[target];
                        appendTerminalLine(cmd, `Deleted branch ${target}.`);
                    } else {
                        appendTerminalLine(cmd, `error: branch '${target}' not found.`, true);
                    }
                } else {
                    const newBranch = parts[2];
                    simState.branches[newBranch] = simState.branches[simState.HEAD];
                    appendTerminalLine(cmd, `<span class="text-purple-400">Rama '${newBranch}' creada apuntando a ${simState.branches[simState.HEAD]}. (Usa 'git switch ${newBranch}' para moverte a ella)</span>`);
                }
            }
            // --- git switch / git checkout ---
            else if (sub === 'switch' || sub === 'checkout') {
                const createFlag = parts.includes('-c') || parts.includes('-b');
                const branchName = parts[parts.length - 1];
                if (!branchName || branchName === sub) {
                    appendTerminalLine(cmd, `Especifica el nombre de la rama. Ejemplo: git switch main`, true);
                } else if (createFlag) {
                    simState.branches[branchName] = simState.branches[simState.HEAD];
                    simState.HEAD = branchName;
                    simState.reflog.unshift({ hash: simState.branches[branchName], action: `checkout: moving to ${branchName}` });
                    appendTerminalLine(cmd, `Switched to a new branch '<strong class="text-purple-400">${branchName}</strong>'`);
                } else if (simState.branches[branchName]) {
                    simState.HEAD = branchName;
                    simState.reflog.unshift({ hash: simState.branches[branchName], action: `checkout: moving to ${branchName}` });
                    appendTerminalLine(cmd, `Switched to branch '<strong class="text-purple-400">${branchName}</strong>'`);
                } else {
                    // Si la rama no existía, la creamos amablemente para que los botones rápidos funcionen siempre
                    simState.branches[branchName] = simState.branches[simState.HEAD];
                    simState.HEAD = branchName;
                    appendTerminalLine(cmd, `Switched to branch '<strong class="text-purple-400">${branchName}</strong>'`);
                }
            }
            // --- git merge ---
            else if (sub === 'merge') {
                const targetBranch = parts[2];
                if (!targetBranch || !simState.branches[targetBranch]) {
                    appendTerminalLine(cmd, `No existe la rama '${targetBranch || ''}'. Crea primero otra rama con 'git switch -c feature/login' y haz un commit.`, true);
                } else if (targetBranch === simState.HEAD) {
                    appendTerminalLine(cmd, `Ya estás en '${simState.HEAD}'. Primero cámbiate a 'main' con 'git switch main' y luego ejecuta 'git merge ${targetBranch}'.`, true);
                } else {
                    const sourceHash = simState.branches[targetBranch];
                    const currentHash = simState.branches[simState.HEAD];
                    if (sourceHash === currentHash) {
                        appendTerminalLine(cmd, `Already up to date. (No hay commits diferentes para fusionar)`);
                    } else {
                        const mergeHash = generateShortHash();
                        const lastX = Math.max(...simState.commits.map(c => c.x));
                        const isMain = simState.HEAD === 'main';
                        const mergeCommit = {
                            hash: mergeHash,
                            msg: `Merge branch '${targetBranch}' into ${simState.HEAD}`,
                            parent: currentHash,
                            secondParent: sourceHash,
                            branchTrack: simState.HEAD,
                            x: lastX + 115,
                            y: isMain ? 100 : 200
                        };
                        simState.commits.push(mergeCommit);
                        simState.branches[simState.HEAD] = mergeHash;
                        simState.reflog.unshift({ hash: mergeHash, action: `merge ${targetBranch}: Merge made by the 'ort' strategy.` });
                        appendTerminalLine(cmd, `<span class="text-teal-400">Merge made by the 'ort' strategy!</span>\n Commit de fusión <strong class="text-blue-400">${mergeHash}</strong> creado uniendo '${targetBranch}' dentro de '${simState.HEAD}'.`);
                    }
                }
            }
            // --- git reset ---
            else if (sub === 'reset') {
                const currentHash = simState.branches[simState.HEAD];
                const currentCommit = simState.commits.find(c => c.hash === currentHash);
                if (!currentCommit || !currentCommit.parent) {
                    appendTerminalLine(cmd, `Ya estás en el commit inicial del repositorio, no se puede retroceder más.`, true);
                } else {
                    const isSoft = parts.includes('--soft');
                    const isHard = parts.includes('--hard');
                    const parentHash = currentCommit.parent;
                    simState.branches[simState.HEAD] = parentHash;
                    // Remover el commit huérfano del grafo visual si ninguna otra rama apunta a él
                    const otherBranchUsesIt = Object.values(simState.branches).includes(currentHash);
                    if (!otherBranchUsesIt) {
                        simState.commits = simState.commits.filter(c => c.hash !== currentHash);
                    }
                    simState.reflog.unshift({ hash: parentHash, action: `reset: moving to HEAD~1` });
                    if (isSoft) {
                        simState.stagedFiles.push('cambios_del_commit.js');
                        appendTerminalLine(cmd, `<span class="text-amber-300">HEAD ahora está en ${parentHash}. (--soft: El commit se deshizo pero tus cambios quedaron seguros en Staging Area)</span>`);
                    } else if (isHard) {
                        simState.workingFiles = [];
                        simState.stagedFiles = [];
                        appendTerminalLine(cmd, `<span class="text-red-400">HEAD is now at ${parentHash}. (--hard: Commit y cambios eliminados. ¡Recuerda que puedes verlos en 'git reflog'!)</span>`);
                    } else {
                        simState.workingFiles.push('cambios_del_commit.js');
                        appendTerminalLine(cmd, `Unstaged changes after reset:\nM\tcambios_del_commit.js`);
                    }
                }
            }
            // --- git revert ---
            else if (sub === 'revert') {
                const currentHash = simState.branches[simState.HEAD];
                const currentCommit = simState.commits.find(c => c.hash === currentHash);
                const newHash = generateShortHash();
                const lastX = Math.max(...simState.commits.map(c => c.x));
                const isMain = simState.HEAD === 'main';
                const revCommit = {
                    hash: newHash,
                    msg: `Revert "${currentCommit ? currentCommit.msg : 'commit'}"`,
                    parent: currentHash,
                    secondParent: null,
                    branchTrack: simState.HEAD,
                    x: lastX + 115,
                    y: isMain ? 100 : 200
                };
                simState.commits.push(revCommit);
                simState.branches[simState.HEAD] = newHash;
                simState.reflog.unshift({ hash: newHash, action: `revert: Revert "${currentCommit.msg}"` });
                appendTerminalLine(cmd, `[${simState.HEAD} <strong class="text-pink-400">${newHash}</strong>] Revert "${currentCommit.msg}"\n <span class="text-emerald-400">¡Seguro para el equipo! Se creó un nuevo commit que deshace el anterior sin borrar el historial.</span>`);
            }
            // --- git stash ---
            else if (sub === 'stash') {
                if (parts[2] === 'pop') {
                    if (simState.stashes.length === 0) {
                        appendTerminalLine(cmd, `No stash entries found.`, true);
                    } else {
                        const popped = simState.stashes.pop();
                        simState.workingFiles.push(...popped);
                        appendTerminalLine(cmd, `<span class="text-emerald-400">Dropped refs/stash@{0}. Tus archivos guardados (${popped.join(', ')}) volvieron a tu Working Directory.</span>`);
                    }
                } else if (parts[2] === 'list') {
                    if (simState.stashes.length === 0) {
                        appendTerminalLine(cmd, `(Cajón de stash vacío)`);
                    } else {
                        appendTerminalLine(cmd, simState.stashes.map((s, i) => `stash@{${i}}: WIP on ${simState.HEAD}: (${s.join(', ')})`).join('\n'));
                    }
                } else {
                    const filesToStash = [...simState.workingFiles, ...simState.stagedFiles];
                    if (filesToStash.length === 0) {
                        simState.stashes.push(['trabajo_en_progreso.js']);
                    } else {
                        simState.stashes.push(filesToStash);
                    }
                    simState.workingFiles = [];
                    simState.stagedFiles = [];
                    appendTerminalLine(cmd, `<span class="text-amber-300">Saved working directory and index state WIP on ${simState.HEAD}. ¡Tu carpeta quedó limpia para cambiar de rama!</span>`);
                }
            }
            // --- git log ---
            else if (sub === 'log') {
                const lines = simState.commits.slice().reverse().map(c => {
                    const branchBadges = Object.entries(simState.branches)
                        .filter(([_, h]) => h === c.hash)
                        .map(([b, _]) => b === simState.HEAD ? `HEAD -> ${b}` : b)
                        .join(', ');
                    const badgeStr = branchBadges ? ` <span class="text-amber-400">(${branchBadges})</span>` : '';
                    return `<span class="text-blue-400">${c.hash}</span>${badgeStr} ${c.msg}`;
                }).join('\n');
                appendTerminalLine(cmd, lines);
            }
            // --- git reflog ---
            else if (sub === 'reflog') {
                const lines = simState.reflog.map((r, i) => 
                    `<span class="text-amber-400">${r.hash}</span> HEAD@{${i}}: ${r.action}`
                ).join('\n');
                appendTerminalLine(cmd, `<span class="text-cyan-400"># Historial de seguridad (Caja Negra de Git):</span>\n` + lines);
            }
            // --- git diff / show / blame / shortlog / tag / remote / fetch / pull / push / clean ---
            else if (sub === 'diff') {
                appendTerminalLine(cmd, `diff --git a/app.js b/app.js\n--- a/app.js\n+++ b/app.js\n@@ -12,3 +12,5 @@\n- const modoMiedo = true;\n+ const modoMiedo = false;\n+ console.log("Dominando Git en el trabajo");`);
            }
            else if (sub === 'show') {
                const currentHash = simState.branches[simState.HEAD];
                const c = simState.commits.find(x => x.hash === currentHash);
                appendTerminalLine(cmd, `commit <span class="text-amber-400">${c.hash}</span> (HEAD -> ${simState.HEAD})\nAuthor: Desarrollador Pro <dev@empresa.com>\n\n    ${c.msg}\n\n+ Código verificado y funcionando.`);
            }
            else if (sub === 'blame') {
                appendTerminalLine(cmd, `10a4f2c (Ana Líder   2025-02-10 09:15) import { initApp } from './core';\n24b8e1d (Carlos Dev  2025-02-11 14:30) export function autenticarUsuario() {\n24b8e1d (Carlos Dev  2025-02-11 14:30)   return verificarToken();\n10a4f2c (Ana Líder   2025-02-10 09:15) }`);
            }
            else if (sub === 'shortlog') {
                appendTerminalLine(cmd, `    14  Desarrollador Pro\n     9  Ana Líder Técnico\n     6  Carlos Backend`);
            }
            else if (sub === 'tag') {
                const tagName = parts[2] || 'v1.0.0';
                appendTerminalLine(cmd, `<span class="text-emerald-400">Etiqueta '${tagName}' creada sobre el commit actual (${simState.branches[simState.HEAD]}).</span>`);
            }
            else if (sub === 'remote') {
                appendTerminalLine(cmd, `origin\thttps://github.com/mi-empresa/proyecto-trabajo.git (fetch)\norigin\thttps://github.com/mi-empresa/proyecto-trabajo.git (push)`);
            }
            else if (sub === 'fetch') {
                appendTerminalLine(cmd, `From https://github.com/mi-empresa/proyecto-trabajo\n * branch            main       -> FETCH_HEAD\n<span class="text-cyan-400">Información remota actualizada sin modificar tus archivos locales.</span>`);
            }
            else if (sub === 'pull') {
                appendTerminalLine(cmd, `From https://github.com/mi-empresa/proyecto-trabajo\n * branch            ${simState.HEAD} -> FETCH_HEAD\n<span class="text-emerald-400">Already up to date. Tu rama local tiene todos los cambios del equipo.</span>`);
            }
            else if (sub === 'push') {
                simState.remoteBranchHash = simState.branches[simState.HEAD];
                appendTerminalLine(cmd, `Enumerating objects: 5, done.\nWriting objects: 100% (3/3), 412 bytes | 412.00 KiB/s, done.\nTo https://github.com/mi-empresa/proyecto-trabajo.git\n   10a4f2c..${simState.remoteBranchHash}  ${simState.HEAD} -> ${simState.HEAD}\n<span class="text-purple-400">¡Tus commits ya están publicados en GitHub (origin/${simState.HEAD})!</span>`);
            }
            else if (sub === 'clean') {
                appendTerminalLine(cmd, `Would remove temporal_debug.log\nWould remove temp_cache/\n<span class="text-emerald-400">(Simulacro seguro con -n: ningún archivo fue borrado aún)</span>`);
            }
            else {
                appendTerminalLine(cmd, `Comando ejecutado en modo demostración: ${cmd}`);
            }

            updateSimUI();
        }

        function updateSimUI() {
            // Actualizar prompt y barra de estado
            document.getElementById('terminal-prompt').innerHTML = `dev@empresa <span class="text-purple-400">(${simState.HEAD})</span> $`;
            const isClean = simState.workingFiles.length === 0 && simState.stagedFiles.length === 0;
            document.getElementById('sim-status-bar').innerHTML = `Rama actual: <strong class="text-white">${simState.HEAD}</strong> | ${isClean ? '<span class="text-emerald-400">Working tree clean</span>' : '<span class="text-amber-400">Cambios pendientes</span>'}`;

            // Contadores inferiores
            document.getElementById('sim-count-working').textContent = simState.workingFiles.length;
            document.getElementById('sim-list-working').textContent = simState.workingFiles.length ? simState.workingFiles.join(', ') : 'Sin cambios pendientes';

            document.getElementById('sim-count-staged').textContent = simState.stagedFiles.length;
            document.getElementById('sim-list-staged').textContent = simState.stagedFiles.length ? simState.stagedFiles.join(', ') : 'Vacío';

            document.getElementById('sim-count-stash').textContent = simState.stashes.length;
            document.getElementById('sim-list-stash').textContent = simState.stashes.length ? `${simState.stashes.length} paquete(s) en cajón` : '0 guardados';

            renderGitGraphSVG();
        }

        function renderGitGraphSVG() {
            const svg = document.getElementById('git-graph-svg');
            const commits = simState.commits;
            const maxX = Math.max(750, ...commits.map(c => c.x + 140));
            svg.setAttribute('viewBox', `0 0 ${maxX} 280`);

            let html = `
                <defs>
                    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
                        <feGaussianBlur stdDeviation="3" result="blur" />
                        <feComposite in="SourceGraphic" in2="blur" operator="over" />
                    </filter>
                </defs>
                <!-- Carriles guía de fondo -->
                <line x1="30" y1="100" x2="${maxX - 30}" y2="100" stroke="#1e2631" stroke-width="2" stroke-dasharray="6,6" />
                <text x="35" y="82" fill="#485260" font-size="10" font-family="Fira Code">Carril Principal (main)</text>
                <line x1="30" y1="200" x2="${maxX - 30}" y2="200" stroke="#1e2631" stroke-width="2" stroke-dasharray="6,6" />
                <text x="35" y="235" fill="#485260" font-size="10" font-family="Fira Code">Carril Ramas (feature / fix)</text>
            `;

            // 1. Dibujar líneas conectoras entre padres e hijos
            commits.forEach(c => {
                if (c.parent) {
                    const p = commits.find(x => x.hash === c.parent);
                    if (p) {
                        const color = c.y === 100 && p.y === 100 ? '#3b82f6' : '#a855f7';
                        html += `<path d="M ${p.x} ${p.y} C ${(p.x + c.x) / 2} ${p.y}, ${(p.x + c.x) / 2} ${c.y}, ${c.x} ${c.y}" fill="none" stroke="${color}" stroke-width="3.5" />`;
                    }
                }
                if (c.secondParent) {
                    const p2 = commits.find(x => x.hash === c.secondParent);
                    if (p2) {
                        html += `<path d="M ${p2.x} ${p2.y} C ${(p2.x + c.x) / 2} ${p2.y}, ${(p2.x + c.x) / 2} ${c.y}, ${c.x} ${c.y}" fill="none" stroke="#14b8a6" stroke-width="3" stroke-dasharray="5,3" />`;
                    }
                }
            });

            // 2. Dibujar nodos de cada commit y sus etiquetas de rama
            commits.forEach(c => {
                const isMainNode = c.y === 100;
                const fillColor = c.secondParent ? '#14b8a6' : (isMainNode ? '#3b82f6' : '#a855f7');
                
                // Buscar qué ramas apuntan a este commit
                const pointingBranches = Object.entries(simState.branches)
                    .filter(([_, hash]) => hash === c.hash)
                    .map(([bName, _]) => bName);

                const isHeadHere = pointingBranches.includes(simState.HEAD);

                html += `
                    <g class="commit-node cursor-pointer">
                        ${isHeadHere ? `<circle cx="${c.x}" cy="${c.y}" r="20" fill="none" stroke="#f59e0b" stroke-width="2" stroke-dasharray="4,3" />` : ''}
                        <circle cx="${c.x}" cy="${c.y}" r="13" fill="#0d1117" stroke="${fillColor}" stroke-width="4" />
                        <circle cx="${c.x}" cy="${c.y}" r="5" fill="${fillColor}" />
                        
                        <!-- Hash del Commit -->
                        <text x="${c.x}" y="${c.y + 30}" text-anchor="middle" fill="#c9d1d9" font-size="11" font-weight="bold" font-family="Fira Code">${c.hash}</text>
                        <!-- Mensaje corto -->
                        <text x="${c.x}" y="${c.y + 44}" text-anchor="middle" fill="#8b949e" font-size="9.5" font-family="Inter">${c.msg.length > 18 ? c.msg.substring(0, 18) + '…' : c.msg}</text>
                    </g>
                `;

                // Dibujar etiquetas de ramas encima del nodo
                pointingBranches.forEach((bName, idx) => {
                    const isCurrent = bName === simState.HEAD;
                    const badgeY = c.y - 38 - (idx * 24);
                    const badgeColor = bName === 'main' ? '#2563eb' : '#7e22ce';
                    const labelText = isCurrent ? `HEAD → ${bName}` : bName;
                    const boxWidth = Math.max(68, labelText.length * 6.8 + 16);

                    html += `
                        <g>
                            <rect x="${c.x - boxWidth / 2}" y="${badgeY - 14}" width="${boxWidth}" height="20" rx="6" fill="${badgeColor}" stroke="${isCurrent ? '#fbbf24' : '#ffffff33'}" stroke-width="${isCurrent ? '2' : '1'}" />
                            <text x="${c.x}" y="${badgeY}" text-anchor="middle" fill="#ffffff" font-size="10" font-weight="bold" font-family="Fira Code">${labelText}</text>
                        </g>
                    `;
                });
            });

            svg.innerHTML = html;
        }

        /* =====================================================================
           5. CATÁLOGO INTERACTIVO DE COMANDOS (MÓDULO 3)
           ===================================================================== */
        let currentCatFilter = 'all';

        function renderCatalog() {
            const searchVal = (document.getElementById('cmd-search').value || '').toLowerCase().trim();
            const grid = document.getElementById('commands-grid');

            const filtered = GIT_COMMANDS.filter(item => {
                const matchesCat = currentCatFilter === 'all' || item.category === currentCatFilter;
                const matchesSearch = !searchVal ||
                    item.cmd.toLowerCase().includes(searchVal) ||
                    item.syntax.toLowerCase().includes(searchVal) ||
                    item.shortDesc.toLowerCase().includes(searchVal) ||
                    item.workUse.toLowerCase().includes(searchVal) ||
                    item.catName.toLowerCase().includes(searchVal);
                return matchesCat && matchesSearch;
            });

            document.getElementById('count-all').textContent = GIT_COMMANDS.length;

            if (filtered.length === 0) {
                grid.innerHTML = `
                    <div class="col-span-full bg-gh-card border border-gh-border rounded-2xl p-8 text-center">
                        <i class="fa-solid fa-magnifying-glass text-3xl text-gh-muted mb-2"></i>
                        <h4 class="text-white font-bold">No encontramos comandos para "${searchVal}"</h4>
                        <p class="text-xs text-gh-muted mt-1">Intenta buscar palabras como "rama", "borrar", "historial", "subir" o "deshacer".</p>
                    </div>
                `;
                return;
            }

            grid.innerHTML = filtered.map(item => {
                let badgeClass = 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30';
                if (item.safety === 'caution') badgeClass = 'bg-amber-500/10 text-amber-400 border-amber-500/30';
                if (item.safety === 'danger') badgeClass = 'bg-red-500/10 text-red-400 border-red-500/30';

                return `
                    <div class="bg-gh-card border border-gh-border hover:border-blue-500/60 rounded-2xl p-5 flex flex-col justify-between transition-all duration-200 hover:-translate-y-0.5 shadow-lg">
                        <div>
                            <!-- Cabecera de la tarjeta -->
                            <div class="flex items-center justify-between gap-2 mb-3">
                                <span class="text-[11px] font-mono text-gh-muted uppercase tracking-wider">${item.catName}</span>
                                <span class="text-[11px] font-medium px-2.5 py-0.5 rounded-full border ${badgeClass}">${item.safetyLabel}</span>
                            </div>

                            <!-- Comando y Sintaxis -->
                            <div class="flex items-center justify-between">
                                <h3 class="text-lg font-bold font-mono text-white">${item.cmd}</h3>
                                <button onclick="copyText('${item.syntax.replace(/'/g, "\\'")}')" title="Copiar sintaxis" class="text-gh-muted hover:text-white text-xs p-1.5 rounded-lg hover:bg-gh-border/50 transition">
                                    <i class="fa-regular fa-copy"></i>
                                </button>
                            </div>
                            <div class="mt-1.5 bg-gh-bg border border-gh-border rounded-lg px-3 py-1.5 font-mono text-xs text-blue-400 truncate">
                                $ ${item.syntax}
                            </div>

                            <!-- Explicación clara -->
                            <p class="text-xs text-gray-300 mt-3 leading-relaxed">${item.shortDesc}</p>

                            <!-- Mini lista de Flags más comunes -->
                            <div class="mt-3 pt-3 border-t border-gh-border/60 space-y-1.5">
                                <div class="text-[10px] font-semibold uppercase text-gh-muted">Opciones clave en el trabajo:</div>
                                ${item.flags.slice(0, 2).map(fl => `
                                    <div class="text-[11px] bg-gh-bg/60 rounded px-2 py-1">
                                        <code class="text-amber-300 font-mono">${fl.flag}</code>
                                        <span class="text-gh-muted block text-[10px]">${fl.desc}</span>
                                    </div>
                                `).join('')}
                            </div>
                        </div>

                        <!-- Botones de Acción de la Tarjeta -->
                        <div class="mt-4 pt-3 border-t border-gh-border flex items-center justify-between gap-2">
                            <button onclick="openCommandModal('${item.id}')" class="flex-1 py-2 px-3 rounded-xl bg-gh-bg hover:bg-gh-border/60 border border-gh-border text-xs font-medium text-gray-200 transition flex items-center justify-center gap-1.5">
                                <i class="fa-solid fa-circle-info text-blue-400"></i> Ver Guía y Flags
                            </button>
                            <button onclick="tryCommandInSimulator('${item.id}')" class="py-2 px-3.5 rounded-xl bg-blue-600/20 hover:bg-blue-600 border border-blue-500/40 text-blue-300 hover:text-white text-xs font-semibold transition flex items-center gap-1.5">
                                <i class="fa-solid fa-terminal"></i> Simular
                            </button>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function setCategoryFilter(cat) {
            currentCatFilter = cat;
            document.querySelectorAll('.cat-btn').forEach(btn => {
                if (btn.getAttribute('data-cat') === cat) {
                    btn.className = 'cat-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-blue-600 text-white transition';
                } else {
                    btn.className = 'cat-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-gh-bg text-gh-muted hover:text-white border border-gh-border transition';
                }
            });
            renderCatalog();
        }

        function filterCatalog() {
            renderCatalog();
        }

        function openCommandModal(cmdId) {
            const item = GIT_COMMANDS.find(c => c.id === cmdId);
            if (!item) return;

            let badgeClass = 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/30';
            if (item.safety === 'caution') badgeClass = 'bg-amber-500/10 text-amber-400 border border-amber-500/30';
            if (item.safety === 'danger') badgeClass = 'bg-red-500/10 text-red-400 border border-red-500/30';

            const badgeEl = document.getElementById('modal-badge');
            badgeEl.className = `text-xs font-semibold px-2.5 py-1 rounded-full ${badgeClass}`;
            badgeEl.textContent = `${item.catName} • ${item.safetyLabel}`;

            document.getElementById('modal-title').textContent = item.syntax;
            document.getElementById('modal-desc').textContent = `${item.shortDesc} ${item.workUse}`;

            document.getElementById('modal-flags').innerHTML = item.flags.map(f => `
                <div class="p-2 rounded-lg bg-gh-card border border-gh-border flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                    <code class="text-emerald-400 font-bold shrink-0">${f.flag}</code>
                    <span class="text-gray-300 font-sans text-xs">${f.desc}</span>
                </div>
            `).join('');

            document.getElementById('modal-tip').textContent = item.tip;

            const tryBtn = document.getElementById('modal-try-btn');
            tryBtn.onclick = () => {
                closeModal();
                tryCommandInSimulator(item.id);
            };

            const modal = document.getElementById('command-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeModal() {
            const modal = document.getElementById('command-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function tryCommandInSimulator(cmdId) {
            const item = GIT_COMMANDS.find(c => c.id === cmdId);
            if (!item) return;
            switchSection('simulator');
            setTimeout(() => {
                runSimCommand(item.simCmd);
                showToast(`Ejecutado en el simulador: ${item.simCmd}`, 'emerald');
            }, 150);
        }

        /* =====================================================================
           6. RENDERIZADO DEL SALVAVIDAS / BOTÓN DE PÁNICO (MÓDULO 4)
           ===================================================================== */
        function renderPanicScenarios() {
            const container = document.getElementById('panic-scenarios-container');
            container.innerHTML = PANIC_SCENARIOS.map(sc => `
                <div class="bg-gh-card border border-gh-border hover:border-red-500/40 rounded-2xl p-5 flex flex-col justify-between space-y-4">
                    <div class="space-y-3">
                        <div class="flex items-start gap-3">
                            <div class="w-9 h-9 rounded-xl bg-red-500/10 border border-red-500/30 flex items-center justify-center text-red-400 shrink-0 mt-0.5">
                                <i class="fa-solid ${sc.icon}"></i>
                            </div>
                            <div>
                                <h3 class="font-bold text-white text-base leading-snug">${sc.title}</h3>
                                <p class="text-xs text-gh-muted mt-1">${sc.situation}</p>
                            </div>
                        </div>

                        <!-- Pasos de rescate -->
                        <div class="space-y-2.5 pt-2">
                            ${sc.steps.map(st => `
                                <div class="bg-gh-bg border border-gh-border rounded-xl p-3">
                                    <div class="text-xs text-gray-300 mb-1.5 font-medium">${st.label}</div>
                                    <div class="flex items-center justify-between gap-2 bg-[#090d13] px-3 py-2 rounded-lg border border-gh-border/70">
                                        <code class="font-mono text-xs text-emerald-400 overflow-x-auto">${st.cmd}</code>
                                        <button onclick="copyText('${st.cmd.replace(/'/g, "\\'")}')" class="text-gh-muted hover:text-white text-xs px-2 py-1 rounded bg-gh-card border border-gh-border shrink-0 transition">
                                            <i class="fa-regular fa-copy mr-1"></i> Copiar
                                        </button>
                                    </div>
                                </div>
                            `).join('')}
                        </div>
                    </div>

                    <div class="bg-emerald-950/30 border border-emerald-500/30 rounded-xl p-3 flex items-center gap-2.5 text-xs text-emerald-300">
                        <i class="fa-solid fa-shield-heart text-emerald-400 text-base shrink-0"></i>
                        <span>${sc.reassurance}</span>
                    </div>
                </div>
            `).join('');
        }

        /* =====================================================================
           7. NAVEGACIÓN Y UTILIDADES GENERALES
           ===================================================================== */
        function switchSection(sectionName) {
            const sections = ['visualizer', 'simulator', 'catalog', 'panic'];
            sections.forEach(s => {
                const secEl = document.getElementById(`section-${s}`);
                const navEl = document.getElementById(`nav-${s}`);
                if (!secEl || !navEl) return;

                if (s === 'catalog' && sectionName === 'visualizer') {
                    // Mostramos el catálogo también debajo del visualizador al inicio para que todo sea accesible de un vistazo
                    secEl.classList.remove('hidden');
                } else if (s === sectionName) {
                    secEl.classList.remove('hidden');
                } else {
                    secEl.classList.add('hidden');
                }

                // Estilo de botón activo en la barra superior
                if (s === sectionName) {
                    navEl.className = 'nav-btn px-3 py-1.5 rounded-lg text-xs sm:text-sm font-semibold transition flex items-center gap-2 bg-blue-600 text-white shadow';
                } else if (s === 'panic') {
                    navEl.className = 'nav-btn px-3 py-1.5 rounded-lg text-xs sm:text-sm font-medium text-red-400 hover:bg-red-500/10 transition flex items-center gap-2';
                } else {
                    navEl.className = 'nav-btn px-3 py-1.5 rounded-lg text-xs sm:text-sm font-medium text-gh-muted hover:text-white transition flex items-center gap-2';
                }
            });

            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function copyText(text) {
            const tempInput = document.createElement('textarea');
            tempInput.value = text;
            document.body.appendChild(tempInput);
            tempInput.select();
            document.execCommand('copy');
            document.body.removeChild(tempInput);
            showToast(`Comando copiado: ${text}`, 'emerald');
        }

        function showToast(message, color = 'blue') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            let borderCol = 'border-blue-500/50 bg-blue-950/90 text-blue-200';
            if (color === 'emerald') borderCol = 'border-emerald-500/50 bg-emerald-950/90 text-emerald-200';
            if (color === 'amber') borderCol = 'border-amber-500/50 bg-amber-950/90 text-amber-200';
            if (color === 'purple') borderCol = 'border-purple-500/50 bg-purple-950/90 text-purple-200';

            toast.className = `px-4 py-2.5 rounded-xl border ${borderCol} backdrop-blur-md shadow-xl text-xs font-mono flex items-center gap-2 transition-all duration-300`;
            toast.innerHTML = `<i class="fa-solid fa-circle-check"></i> <span>${message}</span>`;
            container.appendChild(toast);

            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateY(10px)';
                setTimeout(() => toast.remove(), 300);
            }, 2600);
        }

        // Inicializar toda la aplicación al cargar la ventana
        window.onload = function () {
            renderFlowZones();
            initSandbox();
            renderCatalog();
            renderPanicScenarios();
        };
    </script>
</body>
</html>
