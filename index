                );
                showToast('git fetch → Detectado nuevo commit de un compañero en GitHub', 'blue');
            }
            else if (action === 'pull') {
                const mateHash = '9f8e7d6';
                const existsInRemote = flowState.remote.some(c => c.hash === mateHash);
                if (!existsInRemote) {
                    flowState.remote.push({
                        id: 'c_mate',
                        hash: mateHash,
                        msg: 'fix: commit de tu compañero en GitHub',
                        tag: 'origin/main'
                    });
                }
                flowState.local = JSON.parse(JSON.stringify(flowState.remote));
                highlightZones(['zone-remote', 'zone-local', 'zone-working']);
                updateFlowExplanation(
