                );
                showToast('Archivos editados en tu Working Directory', 'amber');
            }
            else if (action === 'add') {
                if (flowState.working.length === 0) {
                    flowState.working = [
                        { name: 'login.js', status: 'Modificado (M)' },
                        { name: 'estilos.css', status: 'Nuevo (U)' }
                    ];
                }
                flowState.staging = [...flowState.working];
                flowState.working = [];
                highlightZones(['zone-working', 'zone-staging']);
                updateFlowExplanation(
                    'git add .',
                    'Tus archivos viajaron de tu Escritorio al Área de Preparación (Staging)',
                    'Con <code class="text-emerald-400">git add .</code> subiste tus cambios a la tarima (<strong>2. Staging Area</strong>). Todavía no son un commit permanente, solo están posando para la foto. Ahora haz clic en <strong class="text-blue-400">git commit</strong>.',
                    'Paso 2/4: Archivos en Staging Area listos para commit'
                );
                showToast('git add . → Archivos movidos a Staging Area', 'emerald');
            }
            else if (action === 'commit') {
                if (flowState.staging.length === 0) {
                    // Auto-preparar para que el usuario siempre vea la demostración fluida
                    flowState.staging = [{ name: 'login.js', status: 'Staged' }];
                }
                const newHash = Math.random().toString(16).substring(2, 9);
                flowState.local.push({
                    id: 'c_' + newHash,
                    hash: newHash,
                    msg: 'feat: agregar pantalla login (' + flowState.staging.length + ' arch.)',
                    tag: 'Local'
                });
                flowState.staging = [];
                highlightZones(['zone-staging', 'zone-local']);
                updateFlowExplanation(
                    'git commit -m "feat: agregar login"',
                    '¡Fotografía guardada en tu Repositorio Local (.git)!',
                    'Tus archivos de Staging se convirtieron en el commit <code class="text-blue-400">' + newHash + '</code> dentro de <strong>3. Repositorio Local</strong>. Está 100% seguro en tu disco duro, pero tus compañeros en GitHub aún no lo ven. Haz clic en <strong class="text-purple-400">git push</strong>.',
                    'Paso 3/4: Commit guardado en tu PC (Falta subir a GitHub)'
                );
                showToast('git commit → Nuevo commit guardado localmente', 'blue');
            }
            else if (action === 'push') {
                if (flowState.local.length <= flowState.remote.length) {
                    const newHash = Math.random().toString(16).substring(2, 9);
                    flowState.local.push({
                        id: 'c_' + newHash,
                        hash: newHash,
                        msg: 'feat: avance listo para el equipo',
                        tag: 'Local'
