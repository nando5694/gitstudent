                showToast('git pull → Cambios remotos descargados a tu carpeta', 'emerald');
            }
            else if (action === 'restore') {
                flowState.working = [];
                flowState.staging = [];
                highlightZones(['zone-working', 'zone-staging']);
                updateFlowExplanation(
                    'git restore .',
                    'Cambios temporales descartados y carpeta limpia',
