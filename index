                    showToast('git reset --soft HEAD~1 → Commit devuelto a Staging', 'amber');
                } else {
                    showToast('Solo queda el commit inicial. Haz un commit nuevo primero.', 'amber');
                }
            }

            renderFlowZones();
        }

